{
  "version": 3,
  "framework": {
    "name": "nitro",
    "version": "3.0.261103-rc"
  },
  "overrides": {},
  "routes": [
    {
      "src": "^\\/assets(?:\\/(?<_0>(?:[\\s\\S]*[^/])?\\/*?))??\\/?$",
      "headers": {
        "cache-control": "public, max-age=31536000, immutable"
      },
      "continue": true
    },
    {
      "handle": "filesystem"
    },
    {
      "src": "/assets/(.*)",
      "status": 404,
      "headers": {
        "cache-control": "no-store"
      },
      "continue": false
    },
    {
      "src": "/(.*)",
      "dest": "/__server"
    }
  ]
}